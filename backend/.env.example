# ==============================================================================
# NotifyHub - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# Database
# ------------------------------------------------------------------------------
# PostgreSQL connection string used by FastAPI API and background worker.
# Default inside Docker: postgresql://notifyhub:notifyhub_secret@postgres:5432/notifyhub_db
# Default outside Docker (local host): postgresql://notifyhub:notifyhub_secret@localhost:5433/notifyhub_db
DATABASE_URL=postgresql://notifyhub:notifyhub_secret@postgres:5432/notifyhub_db

# ------------------------------------------------------------------------------
# Security
# ------------------------------------------------------------------------------
# Master API key for administrative endpoints (/admin/*) via X-Admin-Key header.
ADMIN_KEY=admin_master_secret_key_12345

# Secret key used for HMAC hashing and key derivation.
HMAC_SECRET=notifyhub_hmac_secret_token_67890

# ------------------------------------------------------------------------------
# Sessions and Cookies
# ------------------------------------------------------------------------------
# Cookie session lifetime in days. Default: 7
SESSION_DAYS=7

# Name of the HTTP-only session cookie. Default: nh_session
COOKIE_NAME=nh_session

# Set to true in production behind HTTPS to enforce Secure cookies. Default: false
COOKIE_SECURE=false

# Maximum number of active API keys a client can maintain simultaneously. Default: 5
MAX_ACTIVE_KEYS=5

# Maximum failed login attempts before temporary account lockout. Default: 10
LOGIN_MAX_ATTEMPTS=10

# Window in minutes for counting failed login attempts. Default: 15
LOGIN_WINDOW_MINUTES=15

# ------------------------------------------------------------------------------
# Mail
# ------------------------------------------------------------------------------
# Provider to use for email delivery: 'smtp' (default) or 'sendgrid'.
MAIL_PROVIDER=smtp

# SMTP host for local testing (MailHog container in Docker). Default: mailhog
SMTP_HOST=mailhog

# SMTP port. Default: 1025
SMTP_PORT=1025

# Default envelope from-address for SMTP. Default: no-reply@notifyhub.local
SMTP_FROM=no-reply@notifyhub.local

# SendGrid API key (required when MAIL_PROVIDER=sendgrid).
SENDGRID_API_KEY=

# SendGrid verified sender email address (required when MAIL_PROVIDER=sendgrid).
FROM_EMAIL=no-reply@notifyhub.local

# ------------------------------------------------------------------------------
# Limits
# ------------------------------------------------------------------------------
# System-wide daily limit across all clients (UTC day, SendGrid trial margin). Default: 90
GLOBAL_DAILY_LIMIT=90

# Default per-client ingestion rate limit in requests per second. Default: 50
DEFAULT_RATE_LIMIT_PER_SEC=50

# Worker outgoing delivery rate limit in emails per second. Default: 20
OUTGOING_RATE_PER_SEC=20

# ------------------------------------------------------------------------------
# Worker Timings
# ------------------------------------------------------------------------------
# Worker polling interval in seconds when checking for queued deliveries. Default: 1
WORKER_POLL_SECONDS=1

# Delivery lease lock timeout in seconds to prevent stuck items. Default: 60
LOCK_SECONDS=60

# Background reaper interval in seconds to reclaim abandoned delivery locks. Default: 30
REAPER_SECONDS=30

# ------------------------------------------------------------------------------
# Seed Admin
# ------------------------------------------------------------------------------
# Email address for the initial platform administrator created by scripts/seed.py.
ADMIN_EMAIL=admin@notifyhub.local

# Password for the initial platform administrator created by scripts/seed.py.
ADMIN_PASSWORD=AdminSecretPass123!

# ------------------------------------------------------------------------------
# Attachments
# ------------------------------------------------------------------------------
# Maximum number of attachments per notification event. Default: 3
ATTACHMENT_MAX_COUNT=3

# Maximum total decoded size of attachments in megabytes. Default: 5
ATTACHMENT_MAX_TOTAL_MB=5

# Comma-separated list of allowed attachment MIME types. Default: application/pdf
ATTACHMENT_ALLOWED_TYPES=application/pdf

# Retention period in days for storing attachment bytes on dead deliveries. Default: 7
ATTACHMENT_RETENTION_DAYS=7

