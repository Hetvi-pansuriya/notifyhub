# Database connection (inside docker points to postgres service)
DATABASE_URL=postgresql://notifyhub:notifyhub_secret@postgres:5432/notifyhub_db

# Local host connection (when running outside docker)
# DATABASE_URL=postgresql://notifyhub:notifyhub_secret@localhost:5433/notifyhub_db

# Authentication and Security (Rule 3 & Rule 9)
ADMIN_KEY=admin_master_secret_key_12345
HMAC_SECRET=notifyhub_hmac_secret_token_67890

# SMTP Configuration (MailHog)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@notifyhub.local

# Mail Provider Configuration (smtp or sendgrid, default smtp)
MAIL_PROVIDER=smtp
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@notifyhub.local
GLOBAL_DAILY_LIMIT=300
DEMO_ALLOWED_RECIPIENTS=

# Rate Limits and Queue Worker Settings
DEFAULT_RATE_LIMIT_PER_SEC=50
OUTGOING_RATE_PER_SEC=20
WORKER_POLL_SECONDS=1
LOCK_SECONDS=60
REAPER_SECONDS=30

# Session and Auth Settings
SESSION_DAYS=7
COOKIE_NAME=nh_session
COOKIE_SECURE=false
MAX_ACTIVE_KEYS=5
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15
ADMIN_EMAIL=admin@notifyhub.local
ADMIN_PASSWORD=AdminSecretPass123!
