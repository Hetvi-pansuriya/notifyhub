# NotifyHub Production Environment Configuration
# NOTE: Frontend and backend must be served from the same site / origin
# through rewrites (e.g. Vercel rewrites to backend URL), so that the
# session cookie (nh_session) is recognized as a first-party cookie with SameSite=Lax.

DATABASE_URL=postgresql://notifyhub:YOUR_PROD_DB_PASSWORD@prod-db-host:5432/notifyhub_db

# Admin API Key and HMAC Secret
ADMIN_KEY=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_ADMIN_KEY_IN_PRODUCTION
HMAC_SECRET=CHANGE_THIS_TO_A_VERY_LONG_RANDOM_HMAC_SECRET_IN_PRODUCTION

# SMTP Configuration (Production ESP: SendGrid, SES, Mailgun, Postmark, etc.)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=YOUR_SMTP_API_KEY
SMTP_FROM=no-reply@yourdomain.com

# Rate Limits and Queue Worker
DEFAULT_RATE_LIMIT_PER_SEC=50
OUTGOING_RATE_PER_SEC=20
WORKER_POLL_SECONDS=1
LOCK_SECONDS=60
REAPER_SECONDS=30

# Session & Security Settings
SESSION_DAYS=7
COOKIE_NAME=nh_session
# In production, COOKIE_SECURE MUST BE TRUE to ensure cookies are sent over HTTPS only.
COOKIE_SECURE=true
MAX_ACTIVE_KEYS=5
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_MINUTES=15

# Initial Seeding
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_THIS_INITIAL_ADMIN_PASSWORD
SEED_OWNER_PASSWORD=CHANGE_THIS_INITIAL_OWNER_PASSWORD
