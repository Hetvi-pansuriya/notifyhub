{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://notifyhub-94r2.onrender.com/api/:path*"
    },
    {
      "source": "/console/:path*",
      "destination": "https://notifyhub-94r2.onrender.com/console/:path*"
    },
    {
      "source": "/admin/:path*",
      "destination": "https://notifyhub-94r2.onrender.com/admin/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/index.html"
    }
  ]
}